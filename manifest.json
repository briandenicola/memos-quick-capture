{
  "manifest_version": 3,
  "name": "Memos Quick Capture",
  "version": "1.0.0",
  "description": "Quickly send notes, selections, and links from the browser to your self-hosted Memos server.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Send to Memos" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+M" } }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
